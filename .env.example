# NOTE: image is built on nfrastack/laravel:1.0.9-php8.3 (PHP 8.3.36+, patched for CVE-2026-109618/109619); see Dockerfile.`n# Renamed vs old image: SITE_URL->APP_URL, APPLICATION_NAME/APP_TRUSTED_PROXIES/DB_PGSQL_SSL_MODE gain a FREESCOUT_ prefix.
# Railway: rename these variables on the support service before deploying. Logs path is now /logs.
# FreeScout service env vars for the dedicated support deployment.
# Recommended deployment target:
# - Railway project: same project as the existing Handled backend
# - FreeScout service name: freescout-support
# - FreeScout DB service name: handled-support-db
# - Root directory: freescout
# - Public hostname: support.handled.group

ADMIN_EMAIL=founder@handled.group
ADMIN_FIRST_NAME=Handled
ADMIN_LAST_NAME=Support
ADMIN_PASS=change-me
APP_KEY=

APP_URL=https://support.handled.group
FREESCOUT_APPLICATION_NAME=Handled Support
SETUP_TYPE=AUTO
# Keep this disabled for the Handled fork so deploys use the repo source
# rather than replacing custom Blade/CSS/PHP changes with upstream code.
ENABLE_AUTO_UPDATE=FALSE

DB_TYPE=pgsql
DB_HOST=
DB_PORT=5432
DB_NAME=freescout
DB_USER=freescout
DB_PASS=
FREESCOUT_DB_PGSQL_SSL_MODE=require

# Railway mapping from the handled-support-db Postgres service:
# DB_HOST = PGHOST
# DB_PORT = PGPORT
# DB_NAME = PGDATABASE
# DB_USER = PGUSER
# DB_PASS = PGPASSWORD
#
# APP_KEY should be a stable Laravel app key and must not change between deploys.
# The base image consumes APP_KEY directly (and preserves it in /data/config/config).
# Example generation command:
# python -c "import base64, secrets; print('base64:' + base64.b64encode(secrets.token_bytes(32)).decode())"

# Optional proxy settings if Railway or another edge proxy sits in front.
FREESCOUT_APP_TRUSTED_PROXIES=*

# Handled support sync bridge. FREESCOUT_ prefix is required: nfrastack only writes
# FREESCOUT_* vars (prefix stripped) into the Laravel .env that config/app.php reads.
FREESCOUT_HANDLED_SUPPORT_SYNC_ENABLED=false
FREESCOUT_HANDLED_SUPPORT_SYNC_URL=
FREESCOUT_HANDLED_SUPPORT_SYNC_SECRET=
# Optional (all default to true in config/app.php):
# FREESCOUT_HANDLED_SUPPORT_WRITEBACK_UI_ENABLED=true
# FREESCOUT_HANDLED_SUPPORT_WRITEBACK_ACTIVITY_ENABLED=true
# FREESCOUT_HANDLED_SUPPORT_WRITEBACK_ACTIONS_ENABLED=true
# FREESCOUT_HANDLED_SUPPORT_WRITEBACK_ACTION_JS_ENABLED=true

# Persistent storage is still strongly recommended in hosting:
# - /data (also holds Modules/; /assets/modules no longer exists on the nfrastack image)

# Brand mailbox model (managed in FreeScout UI, not consumed directly by the container):
# - support@glassi.co
# - support@rinse.io
# - support@detaild.io
# - support@crumb.io
# - support@fitreply.io
